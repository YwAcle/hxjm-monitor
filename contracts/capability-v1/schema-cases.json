            "minLength": 36,
            "maxLength": 36
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "start_at": {
          "type": "string"
        },
        "end_at": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "type": "string"
        },
        "mode": {
          "type": "string",
