              {
                "required": [
                  "start_at"
                ]
              },
              {
                "required": [
                  "end_at"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "range"
            }
          },
          "required": [
            "start_at",
            "end_at"
          ]
        }
      ]
    },
    "valid": [
      {
        "mode": "latest"
      },
      {
        "mode": "range",
        "start_at": "2026-11-01T00:00:00Z",
        "end_at": "2026-11-04T00:00:00Z"
      }
    ],
    "invalid": [
      {},
      {
        "mode": "latest",
        "start_at": "2026-11-01T00:00:00Z"
      },
      {
        "mode": "range"
      },
      {
        "mode": "latest",
        "limit": 101
      }
    ]
  }
