{
  "capability": {
    "capability_code": "business.gallery.select",
    "display_name": "登记图库select",
    "object_types": [
      "business"
    ],
    "input_kinds": [
      "capability_call"
    ],
    "contract": {
      "input_schema": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "capability_call"
          },
          "payload": {
            "type": "object",
            "properties": {
              "source_asset_id": {
                "type": "string",
                "minLength": 32,
                "maxLength": 32,
                "pattern": "^[0-9a-f]{32}$"
              },
              "candidate_id": {
                "type": "string",
                "pattern": "^([0-9]{1,3}|cancel)$"
              }
            },
            "required": [
              "source_asset_id",
              "candidate_id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "kind",
          "payload"
        ],
        "additionalProperties": false
      },
      "parameters_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_types": [
        "business.gallery.result"
      ]
    },
    "agent": {
      "enabled": true,
      "read_only": true,
      "tool_name": "select_gallery_candidate",
      "description": "仅在用户明确选择截图候选后调用。source_asset_id 必须来自此前截图结果，candidate_id 为用户选择的编号或 cancel；不传图片或框。过期须重新上传。"
    }
  },
  "result_type": {
    "type_code": "business.gallery.result",
    "schema_version": "1",
    "json_schema": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "status"
      ]
    },
    "max_inline_bytes": 10485760
  },
  "instance": {
    "implementation_code": "business.http",
    "implementation_version": "1",
    "source_ids": [],
    "resource_scope": {
      "scope_type": "global",
      "resource_ids": []
    },
    "dispatch_mode": "platform_managed",
    "service_ref": "gallery-business",
    "execution": {
      "adapter": "http",
      "operation": "select",
      "result_type": "business.gallery.result",
      "schema_version": "1"
    }
  }
}
