# 一键切换：local=本地部署，api=调用 OpenAI 兼容 API；修改后重启服务
LLM_MODE=local
# auto：本地检查 /models，API 跳过；也可强制 models 或 none
LLM_HEALTHCHECK=auto

# API 配置：仅 LLM_MODE=api 时启用；填写后无需覆盖下方本地配置
# 根地址通常以 /v1 结尾，不要包含 /chat/completions
LLM_REMOTE_BASE_URL=
LLM_REMOTE_MODEL_ID=
LLM_REMOTE_API_KEY=
# 留空不发送模型特有参数；只有服务商支持时才设置 true / false
LLM_REMOTE_ENABLE_THINKING=
# API 输出格式：json_schema / json_object / none；本地始终保留原始格式
LLM_REMOTE_RESPONSE_FORMAT=json_object

# 本地后端与模型：两种引擎共用同一个模型；API 模式忽略以下推理资源
LLM_BACKEND=vllm
LLM_MODEL_PATH=./Qwen3.8-27B-AWQ-INT4
# 可选：不设置时自动使用模型目录名；修改模型时同步修改或删除此项
LLM_MODEL_ID=Qwen/Qwen3.8-27B-AWQ-INT4
LLM_SERVER_HOST=0.0.0.0
LLM_SERVER_PORT=8000
LLM_API_KEY=unused

# 公共推理资源：vLLM / SGLang 共用
CUDA_VISIBLE_DEVICES=2,3
LLM_TP_SIZE=2
LLM_CONTEXT_LENGTH=65536
LLM_GPU_MEMORY_UTILIZATION=0.85
LLM_DTYPE=bfloat16
LLM_ENABLE_THINKING=false
LLM_CHAT_TEMPLATE=./scripts/chat_templates/qwen3_5_no_thinking.jinja

# 客户端超时（本地 / API 共用）；本地 URL 自动由端口生成，可用 LLM_BASE_URL 覆盖
LLM_CONNECT_TIMEOUT_S=5
LLM_REQUEST_TIMEOUT_S=180
LLM_MAX_RETRIES=2
# Agent 整次请求超时与最终正文生成长度上限；正文上限需与超时匹配
AGENT_REQUEST_TIMEOUT_S=180
AGENT_ANSWER_MAX_NEW_TOKENS=2048
NO_PROXY=127.0.0.1,localhost

# 两个后端各自的运行环境；只在需要时修改
VLLM_ENV_ROOT=./.venv-vllm-qwen
SGLANG_ENV_ROOT=/path/to/sglang-env

# vLLM 特有参数：不影响 SGLang
VLLM_MAX_NUM_SEQS=2
VLLM_LIMIT_MM_PER_PROMPT='{"image":4,"video":0}'
VLLM_ATTENTION_BACKEND=TRITON_ATTN
VLLM_MAX_NUM_BATCHED_TOKENS=8192
VLLM_NO_USAGE_STATS=1

# 全局日志模式：append / overwrite；各日志默认继承，无须重复设置
LOG_WRITE_MODE=overwrite

# 图片和截图检索使用 CLIP-ReID；文字检索使用同一服务上的 Chinese-CLIP 文本接口
REID_FEATURE_BASE_URL=http://100.127.237.7:28024
REID_TIMEOUT_S=30
# 可选：固定文本特征空间与文本契约，留空表示以 /health 返回值为准
REID_TEXT_FEATURE_SPACE_ID=
REID_TEXT_CONTRACT_ID=
REID_TEXT_MAX_CHARS=200

# 会话图片资产：仅保存在进程内，供后续追问重新附带；重启或清理会话后失效
IMAGE_ASSET_TTL_S=1800
IMAGE_ASSET_MAX_PER_SESSION=4
IMAGE_ASSET_MAX_BYTES_PER_SESSION=33554432
IMAGE_ASSET_MAX_TOTAL_BYTES=268435456

DB_PORT=5432
