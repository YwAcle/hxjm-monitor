# Copy to development.local.env; literal KEY=VALUE only, no shell expansion.
FRONTEND_PORT=3104
# Linux build networking; change to default on hosts with a working Docker bridge.
BUILD_NETWORK=host
BACKEND_URL=http://127.0.0.1:18480
ANALYSIS_URL=http://127.0.0.1:28014
REID_URL=http://127.0.0.1:28024
MEDIA_HTTP_URL=http://127.0.0.1:19289
ANALYSIS_ENABLED=true
# Agent endpoint is NOT the LLM /v1 endpoint.
AGENT_URL=
AGENT_ENABLED=false
LLM_REMOTE_BASE_URL=
LLM_REMOTE_MODEL_ID=
# Never pass LLM keys as VITE_* variables.
