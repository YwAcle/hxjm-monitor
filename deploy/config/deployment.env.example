# Copy to deployment.local.env and replace deployment-specific values.
IMAGE_TAG=v0.2-compose1
BUILD_NETWORK=default
INFRA=new
PUBLIC_HOST=127.0.0.1
FRONTEND_PORT=3116
BACKEND_PORT=18580
ANALYSIS_PORT=28114
REID_PORT=28124
RTSP_PORT=19554
MEDIA_HTTP_PORT=19389
MEDIA_ICE_PORT=19391
MEDIA_API_PORT=10497
MYSQL_PUBLISH_PORT=13307
POSTGRES_PUBLISH_PORT=15434
REDIS_PUBLISH_PORT=16381
MYSQL_DATABASE=hxjm_sm
POSTGRES_DATABASE=hxjm
MYSQL_PASSWORD=
POSTGRES_PASSWORD=
INIT_ADMIN_PASSWORD=
PIPELINE_TOKEN=
STREAM_TOKEN=
# Absolute paths inside your own hxjm-yh workspace.
RUNTIME_ROOT=/absolute/path/to/hxjm-yh/.runtime/business
DATA_ROOT=/absolute/path/to/hxjm-yh/business-data
MODEL_ROOT=/absolute/path/to/hxjm-yh/models
CAMERAS_FILE=/absolute/path/to/cameras.local.json
ANALYSIS_GPU_UUID=
REID_GPU_UUID=
RECORDING_ENABLED=yes
RECORDING_SEGMENT_SECONDS=3600
REID_MAX_REQUESTS=8
REID_MAX_FRAMES=16
REID_SAMPLE_FRAMES=8
REID_MAX_PIXELS=4194304
PIPELINE_BACKEND_URL=http://backend:8080
PIPELINE_REID_URL=http://reid:8020
MEDIA_RTSP_URL=rtsp://mediamtx:8554/live

# Optional independent garbage runtime; never changes the main analysis algorithm.
GARBAGE_ENABLED=false
GARBAGE_ANALYSIS_PORT=28134
GARBAGE_GPU_UUID=
# GARBAGE_MODEL_PATH=/models/grounding-dino
# GARBAGE_DEVICE=cuda
# Cleanup disabled by default; simulation is never a fallback for m20.
CLEANUP_MODE=disabled
CLEANUP_SOURCE_ROUTES={}
M20_CONTROL_URL=
CAPABILITY_EXECUTOR_ENABLED=false

# Host-side behavior runtime (explicit setup; no automatic model downloads).
JOYAI_MODEL_PORT=34201
JOYAI_OBSERVER_PORT=34202
JOYAI_REVIEW_PORT=34203
JOYAI_TOOL_PORT=34204
JOYAI_GPU=
JOYAI_REVIEW_GPU=
# Docker backend reaches the host tool using this URL; keep model ports loopback.
JOYAI_BACKEND_TOOL_URL=http://host.docker.internal:34204
JOYAI_TOOL_BIND_HOST=0.0.0.0
