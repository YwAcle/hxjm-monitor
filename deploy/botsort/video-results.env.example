# Copy to the algorithm owner's ignored local-results.env. Fill real values first.
# This file is sourced by scripts/local-common.sh only for HXJM_ANALYSIS_ROOT.
export VIDEO_RESULTS_PERSIST_ENABLED=false
export VIDEO_RESULTS_SERVICE_ID=botsort-producer
export VIDEO_RESULTS_SERVICE_TOKEN='REPLACE_WITH_SERVICE_TOKEN'
# The shared launcher supplies the local backend URL if this variable is omitted.
# export VIDEO_RESULTS_BUSINESS_BASE_URL='http://127.0.0.1:BACKEND_PORT/api/v1/business'
export VIDEO_RESULTS_SOURCE_MAP_FILE="${ROOT_DIR:-$PWD}/local-results-sources.json"
# Use persistent LOCAL storage, outside the Git checkout and outside NFS.
export VIDEO_RESULTS_SPOOL_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/hxjm/tracking-results"
export VIDEO_RESULTS_CAPABILITY_CODE=tracking
export VIDEO_RESULTS_IMPLEMENTATION_CODE=botsort
export VIDEO_RESULTS_IMPLEMENTATION_VERSION='REPLACE_WITH_REGISTERED_RELEASE'
export VIDEO_RESULTS_PARAMETERS_JSON='{}'
export VIDEO_RESULTS_BATCH_FRAMES=10
export VIDEO_RESULTS_BATCH_BYTES=524288
export VIDEO_RESULTS_FLUSH_SECONDS=0.5
export VIDEO_RESULTS_SPOOL_MAX_MIB=512
export VIDEO_RESULTS_TIMEOUT_SECONDS=10
export VIDEO_RESULTS_RETRY_MAX_SECONDS=60
